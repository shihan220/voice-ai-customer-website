DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bangla_voice_ai
PORT=5181
VOICE_MEDIA_ROOT=backend/media
PRIVATE_MEDIA_ROOT=backend/private-media

# Leave disabled until the real provider request/response logic is completed in:
# backend/services/voice-provider.ts
VOICE_MODEL_PROVIDER_ENABLED=false
VOICE_MODEL_API_URL=
VOICE_MODEL_API_KEY=
VOICE_MODEL_ID=
VOICE_MODEL_VOICE_ID=

FRONTEND_URL=http://127.0.0.1:5175
ADMIN_FRONTEND_URL=http://127.0.0.1:5175
BACKEND_URL=http://127.0.0.1:5181
# Used only by the public Vite dev server proxy. Defaults to BACKEND_URL.
FRONTEND_BACKEND_URL=http://127.0.0.1:5181

ADMIN_EMAIL=admin@banglaspeechai.local
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

CUSTOMER_SESSION_SECRET=replace-with-a-second-long-random-secret
CUSTOMER_SESSION_COOKIE_NAME=bangla_voice_user
CUSTOMER_EMAIL_VERIFICATION_REQUIRED=false
CUSTOMER_PHONE_VERIFICATION_REQUIRED=false
# Durable per-network account creation cap. This supplements the short HTTP rate limiter.
CUSTOMER_SIGNUP_DAILY_IP_LIMIT=3
# Durable public lead/sample request cap per network.
PUBLIC_SAMPLE_REQUEST_DAILY_IP_LIMIT=20

# Customer TTS generation. Keep real keys in local .env or deployment env only.
KEYPILLAR_TTS_BASE_URL=https://api.keypillar.org
KEYPILLAR_TTS_ENDPOINT=/v1/voice/generate
KEYPILLAR_TTS_API_URL=
KEYPILLAR_TTS_API_KEY=
KEYPILLAR_TTS_VOICE_ID=keypillar-bd-female
KEYPILLAR_TTS_FORMAT=wav
KEYPILLAR_TTS_PRONUNCIATION_MODE=english_preserve
KEYPILLAR_TTS_VOICE_PROFILES_ENDPOINT=/v1/voice-profiles
KEYPILLAR_TTS_VOICE_PROFILES_API_URL=
KEYPILLAR_TTS_REQUEST_TIMEOUT_MS=180000
# Add comma-separated HTTPS hosts only when Keypillar returns audio from a separate trusted CDN.
KEYPILLAR_TTS_AUDIO_ALLOWED_HOSTS=
TTS_PROVIDER_RETRY_MAX_ATTEMPTS=6
TTS_PROVIDER_RETRY_BASE_DELAY_MS=30000
TTS_PROVIDER_RETRY_MAX_DELAY_MS=300000
TTS_CHUNK_MAX_CHARS=1200
TTS_CUSTOM_VOICE_CHUNK_MAX_CHARS=1200
TTS_CUSTOM_VOICE_PROVIDER_REQUEST_MAX_CHARS=1200
TTS_MAX_INPUT_CHARACTERS=30000
SAMPLE_PREVIEW_DAILY_LIMIT_PER_USER=3
TTS_PREVIEW_DAILY_LIMIT_PER_USER=10
TTS_STARTER_DAILY_FULL_GENERATION_MINUTES=30
TTS_PAID_DAILY_FULL_GENERATION_MINUTES=600
TTS_PDF_EXTRACTION_TIMEOUT_MS=20000
TTS_PDF_MAX_EXTRACTED_CHARS=60000
TTS_PDF_MAX_CONCURRENT_EXTRACTIONS=2
TTS_MAX_ACTIVE_VOICE_PROFILES=3
TTS_VOICE_PROFILE_DAILY_CREATE_LIMIT_PER_USER=3
TTS_VOICE_PROFILE_DAILY_SYNC_LIMIT_PER_USER=6
TTS_VOICE_TEST_PREVIEW_DAILY_LIMIT_PER_USER=6
TTS_VOICE_TEST_PREVIEW_COOLDOWN_MINUTES=30
TTS_VOICE_PROFILE_MAX_UPLOAD_MB=40
TTS_VOICE_PROFILE_MAX_CONCURRENT_PROCESSING=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROCESS_TIMEOUT_MS=180000

# Node HTTP connection limits. Keep the request timeout long enough for provider-backed operations.
HTTP_REQUEST_TIMEOUT_MS=300000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GOLD_PRICE_ID=
STRIPE_PLATINUM_PRICE_ID=
STRIPE_EXTRA_TOKEN_PRICE_ID=

BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://127.0.0.1:5181/api/payments/bkash/callback
BKASH_GOLD_AMOUNT_BDT=
BKASH_PLATINUM_AMOUNT_BDT=
BKASH_EXTRA_TOKEN_AMOUNT_BDT=
PAYMENT_PROVIDER_REQUEST_TIMEOUT_MS=20000

# Use a separate disposable database when running:
# npm run verify:db:fresh
# Its database name must contain "fresh_test"; the verifier refuses any other database.
